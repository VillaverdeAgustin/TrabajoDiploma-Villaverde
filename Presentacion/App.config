<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Ajustar Data Source si la instancia de SQL Server tiene otro nombre.
             Base creada por los scripts de db/ (01 a 04). -->
        <add name="ConectAR"
             connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=ConectAR_DB;Integrated Security=True"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
